DATABASE_URL="postgresql://user:password@localhost:5432/dynamus_capital?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS="http://localhost:3000"

# Provedor de CPF (enriquecimento cadastral) - configurar quando o cliente definir o provedor
# Ex.: Assertiva, BigDataCorp, Direct Data. Sem isso, /lookup/cpf retorna vazio (preenchimento manual).
CPF_LOOKUP_URL=
CPF_LOOKUP_API_KEY=

# Provedor de Placa (dados veiculares) - configurar quando o cliente definir o provedor
# Ex.: WDAPI2, Apiplaca, Placa FIPE API. Sem isso, /lookup/placa retorna vazio (preenchimento manual).
PLACA_LOOKUP_URL=
PLACA_LOOKUP_API_KEY=

# Usados apenas pelo script de seed (app/seed.py)
SEED_ADMIN_EMAIL=admin@dynamuscapital.com.br
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOME=Administrador
