generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                String     @id @default(cuid())
  tipoPessoa        TipoPessoa @default(PF)
  // CPF (PF) ou CNPJ (PJ), só dígitos
  documento         String
  // Nome completo (PF) ou razão social (PJ)
  nome              String
  // Data de nascimento (PF) ou de abertura da empresa (PJ)
  dataNascimento    String
  tipoSeguro        TipoSeguro
  placa             String?
  modeloVeiculo     String?
  anoVeiculo        String?
  // Vida em Grupo: número de vidas na empresa
  numeroDependentes Int?
  // Vida e Residencial
  valorCobertura    String?
  // RC Profissional
  profissao         String?
  valorRisco        String?
  observacoes       String?
  cep               String
  rua               String
  numero            String
  complemento       String?
  bairro            String
  cidade            String
  uf                String
  email             String
  celular           String
  status            StatusLead @default(NOVO)
  origem            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([tipoSeguro])
  @@index([createdAt])
  @@index([documento])
}

enum TipoSeguro {
  VIDA
  VIDA_EMPRESARIAL
  VEICULAR
  MOTO
  CAMINHAO
  EMPRESARIAL
  RESPONSABILIDADE_CIVIL
  RC_PROFISSIONAL
  RESIDENCIAL
  EVENTOS
}

enum TipoPessoa {
  PF
  PJ
}

enum StatusLead {
  NOVO
  CONTATADO
  COTACAO_ENVIADA
  CONVERTIDO
  PERDIDO
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  senha     String
  nome      String
  createdAt DateTime @default(now())
}
