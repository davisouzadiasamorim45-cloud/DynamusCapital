generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                String     @id @default(cuid())
  cpf               String
  nome              String
  dataNascimento    String
  tipoSeguro        TipoSeguro
  placa             String?
  modeloVeiculo     String?
  anoVeiculo        String?
  numeroDependentes Int?
  valorCarga        String?
  observacoes       String?
  cep               String
  rua               String
  numero            String
  complemento       String?
  bairro            String
  email             String
  celular           String
  status            StatusLead @default(NOVO)
  origem            String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([status])
  @@index([tipoSeguro])
  @@index([createdAt])
}

enum TipoSeguro {
  VIDA
  VIDA_EMPRESARIAL
  VEICULAR
  MOTO
  CAMINHAO
  CARGA
  EMPRESARIAL
  RESPONSABILIDADE_CIVIL
  RC_PROFISSIONAL
  RESIDENCIAL
  EVENTOS
}

enum StatusLead {
  NOVO
  CONTATADO
  COTACAO_ENVIADA
  CONVERTIDO
  PERDIDO
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  senha     String
  nome      String
  createdAt DateTime @default(now())
}
